{
  "name": "tik2map-functions",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:oembed": "tsx scripts/test-oembed.ts",
    "test:gemini": "tsx --env-file=.env scripts/test-gemini.ts",
    "test:places": "tsx --env-file=.env scripts/test-places.ts",
    "test:firestore": "tsx scripts/test-firestore.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^20.16.11"
  }
}
