# These two are only used when running the isolation test scripts locally
# (scripts/test-gemini.ts, scripts/test-places.ts) via e.g.:
#   GEMINI_API_KEY=xxx npm run test:gemini -- "some caption"
#
# The deployed Cloud Functions do NOT read these from .env - they use
# Firebase secrets instead (set once via the commands below, not committed
# anywhere):
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set PLACES_API_KEY

# Google AI Studio API key (Gemini). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud API key restricted to "Places API (New)" only.
# Get one at https://console.cloud.google.com/apis/credentials (same GCP
# project as this Firebase project).
PLACES_API_KEY=
