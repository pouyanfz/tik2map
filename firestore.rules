rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app, no auth in v1. Reads are open (personal place list,
    // nothing sensitive). Writes only happen server-side via the savePlace
    // Cloud Function (Admin SDK bypasses these rules), so direct client
    // writes are always denied.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
