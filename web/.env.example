# Firebase client config - find these in Firebase Console > Project settings >
# General > Your apps > SDK setup and configuration (or `firebase apps:sdkconfig web`).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mapbox public token, URL-restricted once deployed.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
